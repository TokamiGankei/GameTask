<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="PlayniteSDK" Version="6.*" />
		<Reference Include="Microsoft.CSharp" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="screenshots\" />
	</ItemGroup>

	<ItemGroup>
		<!-- Exclude standalone FocusGuard project from this build -->
		<Compile Remove="GameTask.FocusGuard\**" />
		<None Remove="GameTask.FocusGuard\**" />
	</ItemGroup>

	<ItemGroup>
		<Page Include="SettingsView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
		<Page Include="DiagnosticsView.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>

</Project>
